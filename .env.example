# Either name works for these two — the code accepts both spellings.
# WHATSAPP_ACCESS_TOKEN is checked first, then WHATSAPP_TOKEN.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID is checked first, then PHONE_NUMBER_ID.
WHATSAPP_PHONE_NUMBER_ID=
PHONE_NUMBER_ID=
WABA_ID=
VERIFY_TOKEN=
# Graph API version. Versions expire ~2 years after release — v19.0 (Jan 2024)
# is expired and every call against it fails.
GRAPH_API_VERSION=v22.0
# --- AI providers, tried in this order ---
# 1) NVIDIA NIM (primary) — get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
# 2) Gemini (optional) — must be a Google AI Studio key: 39 chars starting AIzaSy
#    https://aistudio.google.com/apikey  (an "AQ.*" OAuth token will NOT work)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 3) Groq (last resort) — free tier is only 100k tokens/day
GROQ_API_KEY=
# Messages of history sent to the model (full history is still stored in Supabase)
MAX_CONTEXT_MESSAGES=20
SUPABASE_URL=
SUPABASE_KEY=
# Digits only: country code, no '+', no leading zero, no spaces/dashes.
OWNER_PHONE=923044881260
# Approved WhatsApp template that delivers lead alerts to the owner even when the
# owner's 24h session window is closed. Must have exactly 4 body variables:
# {{1}} name, {{2}} number, {{3}} message, {{4}} time.
OWNER_ALERT_TEMPLATE=owner_lead_alert
# Language code the templates are approved under ("en" or "en_US"). If the first
# one 132001s, the other is retried automatically.
TEMPLATE_LANG=en
# Anti-spam / security
META_APP_SECRET=
BROADCAST_SECRET=
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
# Follow-up scheduler keep-alive
CRON_SECRET=speaklab2026
RAILWAY_PUBLIC_DOMAIN=
