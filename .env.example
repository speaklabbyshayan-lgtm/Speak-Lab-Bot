WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
# --- AI providers, tried in this order ---
# 1) NVIDIA NIM (primary) — get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
# 2) Gemini (optional) — must be a Google AI Studio key: 39 chars starting AIzaSy
#    https://aistudio.google.com/apikey  (an "AQ.*" OAuth token will NOT work)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 3) Groq (last resort) — free tier is only 100k tokens/day
GROQ_API_KEY=
# Messages of history sent to the model (full history is still stored in Supabase)
MAX_CONTEXT_MESSAGES=20
SUPABASE_URL=
SUPABASE_KEY=
OWNER_PHONE=
# Approved WhatsApp template that delivers lead alerts to the owner even when the
# owner's 24h session window is closed. Defaults to new_lead_alert.
OWNER_ALERT_TEMPLATE=new_lead_alert
# Anti-spam / security
META_APP_SECRET=
BROADCAST_SECRET=
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
# Follow-up scheduler keep-alive
CRON_SECRET=speaklab2026
RAILWAY_PUBLIC_DOMAIN=
